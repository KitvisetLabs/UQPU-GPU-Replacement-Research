  "required_integration_relations": [
    "A<->B", "A<->C", "A<->F", "B<->F", "C<->F", "D<->G", "D<->E", "D<->F", "E<->G", "E<->F", "G<->F", "H<->A", "H<->B", "H<->C", "H<->D", "H<->E", "H<->F", "H<->G"
