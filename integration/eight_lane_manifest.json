    "D": {"folder": "research_lanes/D_device_chip_fabrication_packaging", "primary": "device, chip, fabrication and packaging"},
    "E": {"folder": "research_lanes/E_materials_energy_cooling_infrastructure", "primary": "materials, biomass, energy, cooling and infrastructure"},
    "F": {"folder": "research_lanes/F_economics_benchmarks_evidence_integration", "primary": "economics, benchmarks, evidence and integration accounting"},
    "G": {"folder": "research_lanes/G_manufacturing_equipment_factory_software", "primary": "manufacturing equipment, factory software and production systems"},
    "H": {"folder": "research_lanes/H_strategy_finance_future_industries", "primary": "strategy, finance and future industries"}
